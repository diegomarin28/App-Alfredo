# Copy to .env.local
DATA_BACKEND=memory
# Solo si DATA_BACKEND=supabase (servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: corre el contrato contra un proyecto de PRUEBA (nunca el real)
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# Login (passkey / Face ID)
# Secreto de la cookie de sesión: 32+ caracteres al azar (p. ej. `openssl rand -base64 48`)
SESSION_SECRET=
# Código para registrar Face ID en /configurar: 20+ caracteres al azar (no hay límite de intentos;
# más corto no se acepta nunca). Solo sirve para la primera passkey; después hay que estar adentro.
SETUP_CODE=
# Dominio de la app (sin https://) y origen completo
NEXT_PUBLIC_RP_ID=localhost
APP_ORIGIN=http://localhost:3100

# Modo familia: link /familia?codigo=<FAMILY_CODE> (20+ caracteres al azar, apto para URL; más corto
# no se acepta nunca), vale hasta FAMILY_EXPIRES_AT
FAMILY_CODE=
FAMILY_EXPIRES_AT=2026-11-25T23:59:00-03:00

# Solo pruebas locales (nunca en producción): habilita /api/test/*
ENABLE_TEST_ROUTES=

# IA (solo servidor). En producción es obligatoria: sin ANTHROPIC_API_KEY la app dice
# "La IA no está configurada, avisale a Diego." Fuera de producción (o con AI_BACKEND=fake) se usa una IA falsa.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Precios USD por millón de tokens: completar desde docs.claude.com pricing (sin esto la IA se niega a funcionar)
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# Saldo total y umbral del aviso por mail (USD)
AI_BUDGET_USD=20
AI_ALERT_USD=16
# Mail (Resend). En producción, sin RESEND_API_KEY el aviso de saldo no se manda: queda un console.error
# y no se marca como enviado. Fuera de producción (o con AI_BACKEND=fake) se usa un mail falso.
ALERT_EMAIL=
ALERT_FROM=App Alfredo <onboarding@resend.dev>
RESEND_API_KEY=
# Solo pruebas: fake fuerza IA y mail falsos
AI_BACKEND=

# Avisos push (genera las claves con `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@mail.com
# Secreto del cron de Vercel (largo y al azar): Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
